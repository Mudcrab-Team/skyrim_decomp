{
  "runners_schema": 1,
  "attempt": "mac",
  "confirm": [
    "mac",
    "winpc"
  ],
  "hosts": {
    "boat": {
      "backend": "boat"
    },
    "mac": {
      "backend": "local",
      "host_id": "mac-wine",
      "machine": "example-wine",
      "loader": "wine",
      "msvc": ".local/toolchains/msvc-19.16.27054",
      "wine_bin": ".local/toolchains/wine-11.0_1/Wine Stable.app/Contents/Resources/wine/bin",
      "wineprefix": ".local/verifier/hosts/mac/wineprefix",
      "work": ".local/verifier/hosts/mac/work",
      "max_parallel": 6
    },
    "winpc": {
      "backend": "ssh",
      "host_id": "winpc-native",
      "machine": "example-windows",
      "loader": "native",
      "ssh_config": ".local/winpc/ssh_config",
      "ssh_host": "winpc",
      "python": ["py", "-3.12"],
      "msvc": "C:/example/verifier/msvc",
      "image": "C:/example/verifier/private/SkyrimSE.exe",
      "work": "C:/example/verifier/work",
      "max_parallel": 8,
      "max_sessions": 4,
      "batch": 16
    },
    "ci": {
      "backend": "ci-hash",
      "host_id": "github-windows-native",
      "machine": "github-hosted-windows",
      "loader": "native",
      "repository": "Mudcrab-Team/skyrim_decomp"
    }
  }
}
