LABEL = 'standing'


# A compile error is usually a typo or an include the Drafter can fix without learning anything
# about the target, so the first few per unit are free; the cap keeps a unit that never compiles
# from looping on the machine forever.
FREE_COMPILE_FAILURES = 3
# Host refusals before any compile: image missing or wrong (42), copy not matching the spec (43),
# toolchain not matching the pins (44), host agent refusing its inputs (45). They say nothing about
# the candidate and give the Drafter no result, so they never count against the budget.
INFRASTRUCTURE_EXITS = (42, 43, 44, 45)


def log_rows(log):
    if not log.is_file():
        return []
    return [json.loads(line) for line in log.read_text().splitlines() if line.strip()]


def counted_attempts(log, tier="first"):
    """Attempts that count against max_attempts: every logged run except binding-only ones and
    the free compile failures."""
    return sum(1 for r in log_rows(log) if r.get('counted', True) and r.get('tier', 'first') == tier)


def charge(code, binding_only, log, tier="first"):
    """(counted, free_compile_failure) for a finished run: binding-only runs and host refusals
    (INFRASTRUCTURE_EXITS) never count, and a compile failure (exit 3) is free while fewer than
    FREE_COMPILE_FAILURES were free before."""
    if binding_only or code in INFRASTRUCTURE_EXITS:
        return False, False
    if code == 3 and sum(1 for r in log_rows(log) if r.get('free_compile_failure') and r.get('tier', 'first') == tier) < FREE_COMPILE_FAILURES:
        return False, True
    return True, False


def missing_source_message(task, repo=None):
    """Plain words and the next step when the unit's .cpp does not exist yet (the case the include
    scan reports as "not a repository-relative regular file"); None otherwise, so every other
    path through attempt is unchanged. Nothing has been compiled or counted at that point."""
    repo = Path(repo or pipeline.REPO)
    cpp = task['compiled']
    if (repo / cpp).exists():
        return None
    header = cpp[:-len('.cpp')] + '.h'
    tdir = Path(task['dir'])
    shown = (tdir.relative_to(repo) if tdir.is_relative_to(repo) else tdir).as_posix()
    also = '' if (repo / header).exists() else f' (nor does {header})'
    return (f'{cpp} does not exist yet{also}, so there is nothing to compile; this run was not counted. '
            f'Create {cpp} and {header} first. To get starting files with every header line, the labels and '
            f'one stub per function, run: python3 tools/skeleton.py {shown}')


def results_of(task, dest):
    out = {}
    for fn in task['functions']:
        try:
            report = json.loads((dest / f'0x{fn["rva"]:x}' / 'report.json').read_text())
        except (OSError, ValueError):
            report = {}
        out[fn['rva']] = report.get('reason')
    return out


# unit_build's status when the comparator process failed instead of writing a pass or fail report.
COMPARATOR_ERROR_EXIT = 2


def comparator_errored(task, dest):
    """True when some function's report is the error record of a comparator that wrote no verdict.

    A reference the map does not name yet (a compiler-made constant, for one) can end that way
    before binding has had a chance to add it, so binding still has to run.
    """
    for fn in task['functions']:
        try:
            report = json.loads((Path(dest) / f'0x{fn["rva"]:x}' / 'report.json').read_text())
        except (OSError, ValueError):
            continue
        if isinstance(report, dict) and report.get('verify_function') == 'comparator-error':
            return True
    return False


def recorded_exit(dest, code):
    """The unit build's own exit status when the host agent recorded it, else the transport's.

    An ssh shell on Windows can report any failed command as exit 1, which made a compile
    failure (3) look like a comparison run that produced no report.
    """
    try:
        recorded = int((Path(dest) / 'unit-exit.txt').read_text().strip())
    except (OSError, ValueError):
        return code
    return recorded if recorded in (0, 1, 2, 3, 4, 125) else code


def run_once(task, host, files, task_dir, dest):
    stage = task_dir / '.attempt'
    root = pipeline.private_root(task_dir)
    if not stage.resolve().is_relative_to(root) or not dest.resolve().is_relative_to(root):
        raise PipelineError("attempt output must stay inside the task's .local directory")
    with tempfile.TemporaryDirectory(dir=stage) as tmp:
        snapshot = Path(tmp) / 'src'
        snapshot.mkdir()
        staged_files = snapshot_sources(task, files, snapshot)
        code, out = host.run(staged_files, stage)
        dest.parent.mkdir(parents=True, exist_ok=True)
        try:
            host.fetch(dest)
        except (boatctl.BoatError, runners.RunnerError):
            shutil.rmtree(dest, ignore_errors=True)
            dest.mkdir(parents=True, exist_ok=True)
        snapshot.rename(dest / 'src')
    (dest / 'remote.txt').write_text(out)
    return recorded_exit(dest, code)


def snapshot_sources(task, files, snapshot):
    """Stage the unit's source and sibling includes, and compile from the saved copies."""
    unit = Path(task['compiled'])
    staged = dict(files)
    for name, source in files.items():
        path = Path(name)
        if path.parent == unit.parent:
            staged[name] = snapshot / path.name
            shutil.copyfile(source, staged[name])
    header = Path(files[task['compiled']]).with_suffix('.h')
    if header.is_file() and not (snapshot / header.name).exists():
        shutil.copyfile(header, snapshot / header.name)
    return staged


def attempt_numbers(directory):
    return sorted((p for p in directory.iterdir() if p.name.isascii() and p.name.isdecimal()
                   and not p.is_symlink() and p.is_dir()), key=lambda p: int(p.name)) if directory.is_dir() else []


def write_diff_signature(task, dest):
    signatures = {}
    for fn in task['functions']:
        rva = f'0x{fn["rva"]:x}'
        folder = dest / rva
        report = attempt_progress.read_json(folder / 'report.json')
        alignment = attempt_progress.read_json(folder / 'align.json')
        signatures[rva] = {} if report.get('result') == 'pass' else alignment.get('diff_signature')
    (dest / 'diff-signature.json').write_text(json.dumps(signatures, separators=(',', ':'), sort_keys=True) + '\n')


def prune_attempts(scope, cap, keep=None):
    """Remove oldest logged attempt results under a private scope, using the task lock for deletion."""
    import file_lock

    scope = Path(scope).resolve()
    root = pipeline.private_root(scope)
    if not scope.is_dir():
        raise PipelineError(f'no private directory: {scope}')
    lock = root / '.attempt-retention.lock'
    if lock.is_symlink():
        raise PipelineError(f'retention lock must be a regular file: {lock}')
    with lock.open('a') as handle:
        flags = file_lock.LOCK_EX | file_lock.LOCK_NB if keep is not None else file_lock.LOCK_EX
        file_lock.flock(handle, flags)
        return prune_locked(scope, cap, keep)


def prune_locked(scope, cap, keep):
    completed = []
    for parent, dirs, _ in os.walk(scope):
        if 'attempts' not in dirs:
            continue
        dirs.remove('attempts')
        attempts = Path(parent) / 'attempts'
        if attempts.is_symlink():
            continue
        try:
            logged = {row.get('attempt') for row in log_rows(attempts.parent / 'attempts.jsonl') if isinstance(row, dict)}
        except (OSError, ValueError):
            continue
        for run in attempt_numbers(attempts):
            if int(run.name) not in logged:
                continue
            try:
                finished = (run / 'attempt.txt').stat().st_mtime_ns
                size = sum((Path(folder) / name).lstat().st_size
                           for folder, _, names in os.walk(run) for name in names)
            except FileNotFoundError:
                continue
            completed.append((finished, run, size))
    total = sum(size for _, _, size in completed)
    removed = 0
    for _, run, size in sorted(completed):
        if total <= cap:
            break
        if run == keep:
            continue
        task = run.parents[1]
        if not (task / '.attempt').resolve().is_relative_to(scope):
            continue
        try:
            lock = nullcontext() if keep is not None and task == keep.parents[1] else pipeline.lock(task)
        except PipelineError:
            continue
        with lock:
            if run.is_symlink() or run.parent.is_symlink() or not run.is_dir():
                continue
            shutil.rmtree(run)
            total -= size
            removed += 1
    return removed, total


def prune_message(removed, total, cap):
    return f'attempt retention: pruned {removed} result(s), {total} bytes remain (cap {cap})'


def fallback_budget(task_dir, qdir, tier='fallback'):
    unit = wq.find_unit(qdir, str(task_dir))
    claim_path = wq.tier_dir(qdir, 'claims', tier) / f'{unit["key"]}.lock'
    claim = wq.read_claim(claim_path)
    if not claim:
        raise wq.QueueError(f'{tier} attempt requires a claimed {tier} unit')
    entry = profiles.role(claim.get('profile'), 'drafter_' + tier)
    return entry['attempts_per_function'] * len(wq.unpassed(qdir, unit, tier))


def retry_alternatives(task, host, task_dir, dest, image, objdump=None, force=False):
    """Lines for the failed functions that byte-match under an alternative flag set of the unit's recipe.

    Advisory (docs/verification.md, "Alternative flag sets"): the attempt's verdict stays the one under the
    unit's own recipe. The unit is accepted under other flags only once its `Recipe:` line names the
    alternative recipe, which the CI hash job and the second host then compile with. A function without
    an exception frame in the pinned image is retried without /EHsc; the host compiles the unit once per
    alternative and every function is compared, so the line also says whether the passing ones keep passing.
    """
    sys.path.insert(0, str(pipeline.REPO / 'tools'))
    import recipe_alternatives as alts
    from pecoff import Reject
    options = alts.alternatives(pipeline.REPO, task.get('recipe') or '')
    failed = []
    for fn in task['functions']:
        try:
            rep = json.loads((dest / f'0x{fn["rva"]:x}' / 'report.json').read_text())
        except (OSError, ValueError):
            continue
        if rep.get('result') != 'pass' and rep.get('reason') not in bind.BINDING_REASONS and 'internal_selector' not in fn:
            failed.append(fn)
    if not options or not failed:
        return []
    frames = None
    if any(a['requires'] == 'target-no-eh-frame' for a in options) and image and Path(image).is_file():
        try:
            frames = alts.EhFrames.from_bytes(Path(image).read_bytes())
        except (OSError, ValueError, Reject):
            frames = None
    lines = []
    for alt in options:
        wanted = [fn for fn in failed if alts.applies(alt, frames, fn['rva'], fn['size'], force)]
        if not wanted:
            continue
        alt_task = dict(task, recipe=alt['recipe'])
        adest = dest / ('alt-' + alt['id'])
        try:
            files, _ = pipeline.unit_manifest(alt_task)
            with_host_tools(files, host)
            host.task = alt_task
            code = run_once(alt_task, host, files, task_dir, adest)
        except (PipelineError, boatctl.BoatError, runners.RunnerError, OSError) as exc:
            lines.append(f'  retry {alt["id"]} ({alts.change_text(alt)}): not run ({exc})')
            continue
        finally:
            host.task = task
        if code not in (0, 1):
            write_diff_signature(task, adest)
            lines.append(f'  retry {alt["id"]} ({alts.change_text(alt)}): not compared (exit {code}; see {adest / "remote.txt"})')
            continue
        passing = {}
        for fn in task['functions']:
            try:
                passing[fn['rva']] = json.loads((adest / f'0x{fn["rva"]:x}' / 'report.json').read_text()).get('result') == 'pass'
            except (OSError, ValueError):
                passing[fn['rva']] = False
        won = [fn for fn in wanted if passing[fn['rva']]]
        shifts = []
        for fn in wanted:
            if fn in won:
                continue
            before = (attempt_progress.read_json(dest / f'0x{fn["rva"]:x}' / 'align.json') or {}).get('distance')
            with local_load.heavy('attempt alignment'):
                align.attempt_summary(adest / f'0x{fn["rva"]:x}', disasm.find_objdump(objdump), image,
                                      adest / 'candidate.obj', fn, task['symbols_local'])
            after = (attempt_progress.read_json(adest / f'0x{fn["rva"]:x}' / 'align.json') or {}).get('distance')
            if before is not None and after is not None:
                shifts.append(f'0x{fn["rva"]:x} {before} -> {after}')
        write_diff_signature(task, adest)
        lines.append(f'  retry {alt["id"]} ({alts.change_text(alt)}) on {len(wanted)} function(s): {len(won)} match'
                     + (f'; aligned distance {", ".join(shifts)} (lower is closer)' if shifts else ''))
        if won:
            line = '  ' + ', '.join(f'0x{fn["rva"]:x}' for fn in won) + ': ' + alts.match_line(pipeline.REPO, alt)
            others = [f'0x{rva:x}' for rva, ok in passing.items() if not ok]
            if others:
                line += f' Under these flags {", ".join(others)} would not pass, so a unit that holds them too needs them in a unit of their own.'
            lines.append(line)
    return lines


# Tools a host with llvm-objdump needs to align the failing functions in the run that compiled them.
HOST_ALIGN_TOOLS = ('tools/verifier/align.py', 'tools/verifier/disasm.py')


def with_host_tools(files, host):
    """`files` plus the alignment tools when `host` aligns after its run (see runners.AgentHost.align)."""
    if getattr(host, 'align', False):
        files.update({name: pipeline.REPO / name for name in HOST_ALIGN_TOOLS})
    return files


def alias_lines(task, dest, results):
    """Plain words for each function the comparator rejected as `undeclared-alias`, with the next step.

    The map names another symbol at the function's RVA (an accepted unit's decoration, or a binding
    of an earlier attempt) and the comparator accepts that only with a fold. When the object defines
    that other name too, the unit's own `// CI hash:` line settles which one is the function (bind
    reads it before it chooses by name), so the line is spelled out.
    """
    failing = [fn for fn in task['functions'] if results.get(fn['rva']) == 'undeclared-alias']
    if not failing:
        return []
    try:
        mapped = align.load_symbols(task['symbols_local'])
    except (OSError, ValueError, KeyError):
        return []
    try:
        from pecoff import CoffObject, Reject
        defined = set(bind.defined_functions(CoffObject((Path(dest) / 'candidate.obj').read_bytes())))
    except (OSError, ValueError, ImportError, Reject):
        defined = set()
    out = []
    for fn in failing:
        rva = f'0x{fn["rva"]:x}'
        also = sorted(n for n, r in mapped.items() if r == fn['rva'] and n != fn['symbol'])
        shown = ', '.join(align.display_name(n)[:70] for n in also[:3]) or 'another symbol'
        local = [n for n in also if n in defined]
        if local:
            out.append(f'  {rva} undeclared-alias: the symbol map already holds {shown} at this RVA and the object defines it, '
                       f'but {align.display_name(fn["symbol"])[:70]} was bound by name. Add `// CI hash: {rva} {local[0]}` '
                       'to the unit (a line near its top) and attempt again; nothing else needs to change.')
        else:
            out.append(f'  {rva} undeclared-alias: the symbol map already holds {shown} at this RVA (an accepted unit or an '
                       f'earlier binding) and this unit does not define it; it defines {align.display_name(fn["symbol"])[:70]}. '
                       'Declare the function with the map\'s decoration, or ask for a fold if this one is the right decoration.')
    return out


def attempt(task_dir, tier='first', qdir=None, model=None, agent=None, profile=None, rules=(), advisory=True, retry=True, force_retry=False,
            auto=True, correct=False, verbose=True, max_attempt_bytes=None):
    started = time.monotonic()
    task = pipeline.load_task(task_dir)
    import draft_worktrees
    draft_worktrees.route_attempt(task['dir'], pipeline.REPO)
    task_dir = task['dir']
    handle = pipeline.lock(task_dir)  # held before attribution or attempt writes
    attempts = task_dir / 'attempts'
    done = attempt_numbers(attempts)
    logged = max((row.get('attempt', 0) for row in log_rows(task_dir / 'attempts.jsonl')), default=0)
    number = max(int(done[-1].name) if done else 0, logged) + 1
    budget = task['max_attempts'] if tier == 'first' else fallback_budget(task_dir, qdir, tier)
    used = counted_attempts(task_dir / 'attempts.jsonl', tier)
    if budget is not None and used >= budget:
        print(f'attempt budget exhausted: {budget} of {budget} used. Write your result lines and stop.')
        return 5
    missing = missing_source_message(task)
    if missing:
        # Same exit and stream as the include-closure error this replaces; only the words differ.
        print(f'attempt: {missing}', file=sys.stderr)
        return 2
    raw = json.loads((task_dir / 'task.json').read_text())
    identity_path = task_dir / f'attribution-{tier}.json'
    identity = attempt_progress.read_json(identity_path)
    profile = profile or identity.get('profile') or raw.get('drafter_profile')
    model = agent_identity.resolve(model or identity.get('model') or raw.get('drafter_model') or raw.get('model'),
                                   agent=agent or raw.get('agent') or (raw.get('export') or {}).get('generator'),
                                   profile=profile, tier=tier)
    patience = profiles.get(profile)['stuck_after']
    # Task bytes can be pinned by a generator's resume digest. Keep attribution alongside them.
    draft_worktrees.save(identity_path, dict(model=model, profile=profile or profiles.DEFAULT))
    files, closure = pipeline.unit_manifest(task)
    problem = pipeline.compiler_include_problem(task)
    if problem:
        # Refused before any upload or log entry, so it neither uses the machine nor counts.
        print(f'attempt {number} {task["task_id"]}: REFUSED include (not counted)\n    {agent_advice.explain(problem, "attempt")}')
        return 4
    config = pipeline.load_config(task_dir)
    runner = runners.for_attempt(report=print if verbose else lambda _line: None)
    if runner is None:
        machine, how = pipeline.ensure_standing()
        host = pipeline.Host(machine, LABEL, f'{boatctl.REMOTE_HOME}/tasks/{task["task_id"]}', task,
                             state_path=task_dir / '.attempt' / 'sync.json', local_image=config.get('image'))
        where = f'machine: {boatctl.STANDING} {how}; it stops itself at its deadline'
    else:
        # A result prefetched in a batch (tools/verifier/compare_batch.py) is used only while it matches
        # these exact sources; otherwise this is the plain per-unit run on `runner`.
        host, runner = compare_batch.host_for(task, files, runner, runners.load())
        if hasattr(host, 'align') and runner.get('objdump'):
            host.align = True
            with_host_tools(files, host)
    dest = attempts / f'{number:03d}'
    code = run_once(task, host, files, task_dir, dest)
    bind_lines = []
    # Binding runs on every compile, not only when a reason code says a name is missing: a function
    # bound to the wrong one of several definitions (a plain destructor for a deleting one) fails
    # with a code difference, and a hint added afterwards would otherwise never be read.
    internal = any('internal_selector' in fn for fn in task['functions'])
    if internal:
        bind_lines.append('  internal identities: automatic name binding disabled; use explicit scoped map keys')
    if (not internal and code in (0, 1, COMPARATOR_ERROR_EXIT) and not (dest / 'error.json').is_file()
            and (dest / 'candidate.obj').is_file() and (code != COMPARATOR_ERROR_EXIT or comparator_errored(task, dest))):
        recompared = False

        def recompare():
            """Same source, new names: compile and compare again so this invocation reports real results."""
            nonlocal task, files, closure, code, recompared
            task = pipeline.load_task(task_dir)
            files, closure = pipeline.unit_manifest(task)
            with_host_tools(files, host)
            host.task = task
            code = run_once(task, host, files, task_dir, dest)
            recompared = True

        try:
            with local_load.heavy('attempt binding'):
                report = bind.bind(task_dir, dest / 'candidate.obj', config.get('image'), config.get('objdump'))
        except (OSError, ValueError) as exc:
            report = None
            bind_lines.append('  ' + agent_advice.explain(f'binding failed: {exc}', 'attempt'))
        if report is not None:
            final, hint_lines = report, []
            if report['changed']:
                recompare()
            if auto and (report['unbound_references'] or report['unbound_thread_locals'] or correct) \
                    and (dest / 'candidate.obj').is_file() and code in (0, 1, COMPARATOR_ERROR_EXIT):
                # The alignment is read from the newest run, whose function symbols are bound, so the host
                # aligned every failing function there; hints go to bind-hints.json and bind reads them next.
                try:
                    with local_load.heavy('attempt hints'):
                        added, skipped, notes = auto_hints.derive(task_dir, dest, report, config, correct=correct)
                        hint_lines = auto_hints.describe(added, skipped, notes)
                        second = (bind.bind(task_dir, dest / 'candidate.obj', config.get('image'), config.get('objdump'))
                                  if added else None)
                    if second is not None:
                        final = auto_hints.merge_reports(report, second)
                        if second['changed']:
                            recompare()
                except (OSError, ValueError, KeyError, TypeError) as exc:
                    hint_lines = [f'  auto hints: not derived ({type(exc).__name__}: {exc})']
            bind_lines += hint_lines + bind.describe(final, task_dir)
            if recompared:
                bind_lines.append('  re-compared after binding (same source)')
    results = results_of(task, dest)
    bind_lines += alias_lines(task, dest, results)
    binding_only = code in (0, 1) and bool(results) and all(r in bind.BINDING_REASONS for r in results.values())
    counted, free_compile = charge(code, binding_only, task_dir / 'attempts.jsonl', tier)
    lines, all_rows = [], []
    shown = used + (1 if counted else 0)
    why_free = ''
    if binding_only:
        why_free = ' (binding only, not counted)'
    elif code in INFRASTRUCTURE_EXITS:
        why_free = ' (host refusal, not counted)'
    elif free_compile:
        n = sum(1 for r in log_rows(task_dir / 'attempts.jsonl') if r.get('free_compile_failure') and r.get('tier', 'first') == tier) + 1
        why_free = f' (compile failure {n}/{FREE_COMPILE_FAILURES} free, not counted)'
    head = (f'attempt {number} {task["task_id"]} ({task["compiled"]}); counted {shown}'
            + (f'/{budget}' if budget else '') + why_free)
    error = None
    if (dest / 'error.json').is_file():
        error = json.loads((dest / 'error.json').read_text())
    if code == 3:
        lines += [f'{head}: COMPILE FAILED'] + pipeline.compile_errors(dest / 'compile.log')
    elif error is not None:
        lines.append(f'{head}: REFUSED {error["status"]}')
        lines.append(f'    {error["detail"][:300]}')
    elif code in INFRASTRUCTURE_EXITS:
        lines.append(f'{head}: REFUSED by the host (exit {code}); see {dest / "remote.txt"}')
    else:
        objdump = disasm.find_objdump(config.get('objdump'))
        rows, outcome = [], []
        # The aligned diagnostics and side-by-side listings run objdump over the image for every function.
        with local_load.heavy('attempt diagnostics'):
            for fn in task['functions']:
                fdir = dest / f'0x{fn["rva"]:x}'
                line, result = pipeline.function_line(fn, fdir, dest / 'candidate.obj')
                rows.append('  ' + line)
                outcome.append(result)
                if result == 'fail' and 'internal_selector' not in fn:  # aligned diagnostics (align.py): distance and classes under the function's line
                    rows[-1] += ''.join(f'\n      {s}' for s in align.attempt_summary(
                        fdir, objdump, config.get('image'), dest / 'candidate.obj', fn, task['symbols_local']))
                if 'internal_selector' in fn:
                    continue  # Name-only disassembly helpers cannot select TU-bound internal symbols.
                if (fdir / 'side-by-side.txt').is_file():
                    continue  # written by a host that aligns in its own run
                sbs, why = disasm.write_side_by_side(fdir / 'side-by-side.txt', objdump, config.get('image'),
                                                     dest / 'candidate.obj', fn['symbol'], fn['rva'], fn['size'])
                if sbs is None and why and not any('side-by-side' in r for r in rows):
                    rows.append(f'  (no side-by-side: {why})')
        passed = sum(r == 'pass' for r in outcome)
        lines.append(f'{head}: {passed}/{len(outcome)} pass; includes = closure ({len(closure)} repo files)')
        all_rows = rows
        lines += rows[:10]
        if len(rows) > 10:
            lines.append(f'  ... {len(rows) - 10} more lines in {dest / "attempt.txt"}')
        if retry and passed < len(outcome):
            retried = retry_alternatives(task, host, task_dir, dest, config.get('image'), config.get('objdump'), force_retry)
            lines += retried
            all_rows = rows + retried
    lines.insert(1, f'model/agent: {model}')
    if not used:
        # The first attempt of a unit starts from what earlier drafters learned about its functions.
        try:
            import giveup
            lines[2:2] = giveup.lines_for(pipeline.REPO, [f'0x{fn["rva"]:x}' for fn in task['functions']])
        except (OSError, ValueError, KeyError, TypeError):
            pass
    current = {}
    failed = set()
    for fn in task['functions']:
        rva = f'0x{fn["rva"]:x}'
        fdir = dest / rva
        report = attempt_progress.read_json(fdir / 'report.json')
        alignment = attempt_progress.read_json(fdir / 'align.json')
        if report.get('result') == 'fail':
            failed.add(rva)
        if report.get('result') == 'pass' and 'internal_selector' not in fn:
            alignment = dict(matching_bytes=fn['size'], target_bytes=fn['size'], matching_regions=1)
        current[rva] = attempt_progress.measure(report, alignment)
    history = [r for r in log_rows(task_dir / 'attempts.jsonl') if r.get('tier', 'first') == tier]
    finished_at = time.time()
    progress = attempt_progress.update(current, history, counted, now=finished_at)
    stuck = [advice for rva, metric in progress.items() if counted and rva in failed
             if (advice := attempt_progress.stuck_advice(rva, metric, patience, finished_at))]
    lines += [attempt_progress.describe(rva, metric, patience) for rva, metric in progress.items()]
    lines += stuck
    lines.append(attempt_progress.guidance(patience))
    lines += pipeline.compile_warnings(dest / 'compile.log')
    if code == 1 and error is None:
        lines.append('scored, not exact: the unit compiled and was compared; exit status 1 only says not every '
                     'function passed, it is not a tool failure.')
        if not stuck:
            lines.append('Next: revise the source using the aligned differences and retry; keep going while matching bytes rise.')
        elif len(stuck) < len(failed):
            lines.append('Next: use the aligned differences to revise functions still in the draft loop.')
    elif code != 0:
        problem = 'compile failed' if code == 3 else (error or {}).get('detail', 'host input failed')
        lines.append('Next: ' + agent_advice.next_action(problem, 'attempt'))
    lines += bind_lines
    if advisory:
        lines += label_warnings(closure)
        lines += origin_lines(closure)
        lines += publication_warnings(task)
    rel = dest.relative_to(Path.cwd()) if dest.is_relative_to(Path.cwd()) else dest
    lines.append(f'private: {rel}/ (0x<rva>/side-by-side.txt, compile.log; read locally, never paste)')
    if runner is not None:
        where = f'runner: {runners.describe(runner)}' + (f'; waited {host.waited:.0f} s for a slot'
                                                          if host.waited >= 1 else '')
    lines.append(where)
    lines.append(f'time {time.monotonic() - started:.1f} s')
    lines.extend(verdict_lines(lines[0], all_rows))
    text = '\n'.join(lines)
    write_diff_signature(task, dest)
    (dest / 'attempt.txt').write_text(text + '\n' + ''.join(f'{r}\n' for r in all_rows))
    with open(task_dir / 'attempts.jsonl', 'a') as log:
        log.write(json.dumps({'attempt': number, 'exit': code, 'counted': counted, 'tier': tier, 'model': model, 'progress': progress,
                              **({'cookbook_rules': list(rules)} if rules else {}),
                              **({'free_compile_failure': True} if free_compile else {}),
                              'seconds': round(time.monotonic() - started, 1),
                              'runner': runner['host_id'] if runner else 'boat',
                              'source_revision': _revision(dest)}) + '\n')
    if verbose:
        print(text)
    else:
        print(lines[0])
        actionable = next((line.strip() for line in bind_lines if 'UNBOUND' in line), None)
        if not actionable and code == 3:
            actionable = next((line.strip() for line in lines[1:] if 'error' in line.lower()), None)
        if not actionable and code:
            actionable = next((line.strip() for line in lines if line.startswith('Next:')), None)
        if not actionable and all_rows:
            actionable = all_rows[0].splitlines()[0].strip()
        if actionable:
            print(actionable + f' (details: {rel}/attempt.txt; --verbose for full output)')
        for advice in stuck:
            print(advice)
    if max_attempt_bytes is not None:
        try:
            removed, total = prune_attempts(task_dir, max_attempt_bytes, keep=dest)
            if removed or total > max_attempt_bytes:
                print(prune_message(removed, total, max_attempt_bytes))
        except (PipelineError, OSError, ValueError) as exc:
            print(f'attempt retention: {exc}', file=sys.stderr)
    if runner is None:
        # The standing machine is billed while the attempt runs, so wall time is the draft's compute.
        wall = time.monotonic() - started
        pipeline.record_cost(task, 'draft', wall, wall)
    return {0: 0, 1: 1, 3: 3, 4: 4}.get(code, 2)


def group_status(group_dir):
    """Lines describing a multi-unit task directory (group.json): each unit's counted attempts and
    last result. A group is never compiled as a whole; each unit is attempted on its own."""
    group = json.loads((group_dir / 'group.json').read_text())
    lines = [f'group {group["group_id"]}: {len(group["units"])} units, {group["functions"]} functions; '
             f'attempt each unit: tools/verifier/attempt <this dir>/<unit dir>']
    for u in group['units']:
        udir = group_dir / u['dir']
        used = counted_attempts(udir / 'attempts.jsonl')
        runs = attempt_numbers(udir / 'attempts')
        last = 'result unavailable' if log_rows(udir / 'attempts.jsonl') else 'not attempted'
        if runs and (runs[-1] / 'attempt.txt').is_file():
            head = (runs[-1] / 'attempt.txt').read_text().splitlines()[:1]
            last = head[0].split(': ', 1)[-1] if head else 'no summary'
        lines.append(f'  {u["dir"]}: {u["compiled"]}; {len(u["functions"])} functions; counted {used}/'
                     f'{u["max_attempts"]}; last: {last}')
    return lines


def label_warnings(closure):
    """tools/check_labels.py findings for the unit's sources, printed as warnings after the results.

    They never change the exit status: the label check reads private community checkouts that are
    not always present, and its findings are for the Drafter and Reviewer to judge.
    """
    try:
        sys.path.insert(0, str(pipeline.REPO / 'tools'))
        import check_labels
        findings = check_labels.check([pipeline.REPO / name for name in closure])
    except Exception as exc:  # noqa: BLE001 - a broken optional check must not hide the comparison
        return [f'  label check: not run ({type(exc).__name__}: {exc})']
    if not findings:
        return ['  label check: no findings']
    return [f'  label warning: {f}' for f in findings]


def verdict_lines(head, rows):
    """Repeat the verdict after advice so it remains visible at the end of the output."""
    return [head] + [row.split('\n', 1)[0] for row in rows if row.startswith('  0x')]


def publication_warnings(task):
    """Report per-unit intake and compact-header findings without changing the verdict."""
    try:
        import contrib_validation
        import lint_reconstruction
        cpp = task['compiled']
        names = [cpp, str(Path(cpp).with_suffix('.h'))]
        findings = []
        for name in names:
            path = pipeline.REPO / name
            if not path.is_file():
                continue
            blob = path.read_bytes()
            findings += contrib_validation.leakgrep_diagnostics(blob, name)
            header = lint_reconstruction.leading_comment(blob.decode('utf-8', 'replace'))
            findings += lint_reconstruction.header_budget_problems(name, header)
        return [f'  publication warning: {f}' for f in findings] or ['  publication check: no findings']
    except Exception as exc:  # noqa: BLE001 - advisory must not hide the comparison
        return [f'  publication check: not run ({type(exc).__name__}: {exc})']


def origin_lines(closure):
    """tools/check_origin.py hits for the unit's sources: bodies close to a same-named community or
    FNV body. Advisory like the label check; an adapted body must be declared in the unit header
    (docs/drafter-card.md), which the Reviewer checks starting from this list."""
    try:
        sys.path.insert(0, str(pipeline.REPO / 'tools'))
        import check_origin
        clones, _missing = check_origin.open_clones(pipeline.REPO)
        hits = check_origin.check_unit([pipeline.REPO / name for name in closure], clones, root=pipeline.REPO)
    except Exception as exc:  # noqa: BLE001 - a broken optional check must not hide the comparison
        return [f'  origin check: not run ({type(exc).__name__}: {exc})']
    if not hits:
        return ['  origin check: no body at or above the similarity threshold']
    out = [f'  origin: {check_origin.describe(h)}' for h in hits]
    if any(not h['trivial'] and not h['fork_of'] and not h['declared'] for h in hits):
        out.append('  origin advice: name each adapted body, its upstream file, revision and licence in the '
                   'unit header (FNV: a Sibling source line); docs/drafter-card.md')
    return out


def _revision(dest):
    try:
        return json.loads((dest / 'result.json').read_text())['source_revision']
    except (OSError, ValueError, KeyError):
        return None


def clean(task_dir):
    """Remove this task's directory on the standing machine if it is running; never starts or stops it."""
    task = pipeline.load_task(task_dir)
    handle = pipeline.lock(task['dir'])  # noqa: F841 (held until exit)
    if runners.for_attempt() is not None:
        # Runner hosts get a fresh copy per run and remove it afterwards; nothing is left to remove.
        (task['dir'] / '.attempt' / 'sync.json').unlink(missing_ok=True)
        print('attempt runs on a runner host (.local/verifier/runners.json), which keeps no task files; nothing removed')
        return 0
    machine, state = boatctl.lookup()
    remote = f'{boatctl.REMOTE_HOME}/tasks/{task["task_id"]}'
    if machine is not None and state in boatctl.RUNNING:
        boatctl.execute(machine, f'rm -rf {shlex.quote(remote)}', 60)
        print(f'removed {remote} on {boatctl.STANDING}')
    else:
        print(f'{boatctl.STANDING} is {state}; nothing removed remotely (the next attempt uploads afresh)')
    (task['dir'] / '.attempt' / 'sync.json').unlink(missing_ok=True)
    return 0


def nonnegative_bytes(value):
    value = int(value)
    if value < 0:
        raise argparse.ArgumentTypeError('size cap must be nonnegative')
    return value


def main():
    p = agent_advice.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('task_dir', nargs='?')
    p.add_argument('--tier', choices=('first', 'fallback', 'strong'), default='first')
    p.add_argument('--queue-dir', type=Path)
    p.add_argument('--verbose', action='store_true', help='print the full attempt output')
    p.add_argument('--model', help='actual model id; normally inherited from the queue claim')
    p.add_argument('--agent', help='agent/tool name when no model is used')
    p.add_argument('--profile', choices=sorted(profiles.PROFILES), help='project Drafter profile default')
    p.add_argument('--rule', metavar='N[,M]', help='cookbook rule number(s) that turned a fail into this pass; recorded '
                   'in attempts.jsonl and counted by tools/cookbook_rank.py once the function is accepted')
    p.add_argument('--no-advisory', action='store_true', help='skip the label and origin warnings (about 7 s of '
                   'local work per unit); for callers that only need the verdict and run those checks elsewhere')
    p.add_argument('--no-retry', action='store_true', help='skip the advisory retry of failed functions under the '
                   "recipe's alternative flag sets (data/recipe-alternatives.json); the retry costs one more unit build per alternative")
    p.add_argument('--no-auto-hints', action='store_true', help='do not derive bind hints from the instruction alignment '
                   'for references that stay unbound after binding')
    p.add_argument('--hints-by-alignment', action='store_true', help='also write hints for names bound by position that the '
                   'instruction alignment contradicts (a near-miss whose hints were lost); hides a wrong global in the source, '
                   'so it is for studies, not drafting')
    p.add_argument('--retry-any', action='store_true', help=argparse.SUPPRESS)
    cleanup = p.add_mutually_exclusive_group()
    cleanup.add_argument('--clean', action='store_true', help="remove the task's files on the machine")
    cleanup.add_argument('--prune', action='store_true', help='apply the size cap to a private directory and exit')
    p.add_argument('--max-attempt-bytes', type=nonnegative_bytes, default=os.environ.get('SR_ATTEMPT_MAX_BYTES'),
                   help='opt-in size cap in bytes for the task or explicit prune scope (SR_ATTEMPT_MAX_BYTES)')
    p.add_argument('--stop', action='store_true', help=argparse.SUPPRESS)
    p.add_argument('--force', action='store_true', help=argparse.SUPPRESS)
    a = p.parse_args()
    try:
        if a.stop:
            print('attempt --stop is retired: attempt never stops a machine. Engineers end a session with '
                  'tools/verifier/session down; per-task cleanup is attempt --clean <task-dir>.', file=sys.stderr)
            return 2
        if a.clean:
            if not a.task_dir:
                p.error('--clean needs a task directory')
            return clean(a.task_dir)
        if not a.task_dir:
            p.error('a task directory is required')
        group_dir = pipeline.resolve_task_dir(a.task_dir)
        if a.prune:
            if a.max_attempt_bytes is None:
                p.error('--prune requires --max-attempt-bytes or SR_ATTEMPT_MAX_BYTES')
            removed, total = prune_attempts(group_dir, a.max_attempt_bytes)
            print(prune_message(removed, total, a.max_attempt_bytes))
            return int(total > a.max_attempt_bytes)
        if not (group_dir / 'task.json').is_file() and (group_dir / 'group.json').is_file():
            print('\n'.join(group_status(group_dir)))
            return 2
        if a.tier != 'first' and not a.queue_dir:
            p.error(f'--tier {a.tier} requires --queue-dir')
        try:
            rules = sorted({int(n) for n in a.rule.split(',')}) if a.rule else []
        except ValueError:
            p.error('--rule takes cookbook rule numbers such as 48 or 48,12')
        return attempt(a.task_dir, a.tier, a.queue_dir, a.model, a.agent, a.profile, rules, not a.no_advisory, not a.no_retry, a.retry_any,
                       not a.no_auto_hints, a.hints_by_alignment, a.verbose or bool(os.environ.get('CI')),
                       max_attempt_bytes=a.max_attempt_bytes)
    except (PipelineError, boatctl.BoatError, runners.RunnerError, wq.QueueError, OSError, ValueError, KeyError, TypeError) as exc:
        print(f'attempt: {agent_advice.explain(exc, "attempt")}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
